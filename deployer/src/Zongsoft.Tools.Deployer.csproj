<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
		<DefineConstants>$(DefineConstants);DEPLOYER</DefineConstants>
		<Version>7.15.2</Version>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dotnet-deploy</ToolCommandName>
		<PackageDescription>The Zongsoft Deployment .NET Tool.</PackageDescription>
		<Product>Zongsoft Deployment Tool</Product>
		<Description>Zongsoft Application Deployment Tool.</Description>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageProjectUrl>https://github.com/Zongsoft/tools/tree/main/deployer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Zongsoft/tools/tree/main/deployer</RepositoryUrl>
		<ApplicationIcon>..\..\zongsoft-logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\..\.shared\VariableEvaluator.cs" Link="Shared\VariableEvaluator.cs" />
		<Compile Include="..\..\.shared\Utility.cs" Link="Shared\Utility.cs" />
		<Compile Include="..\..\.shared\ArtifactPublisher.cs" Link="Shared\ArtifactPublisher.cs" />
		<None Remove="Resources/dotnet-runtime-LICENSE.txt" />
		<None Include="Resources/dotnet-runtime-LICENSE.txt" Pack="true" PackagePath="licenses/" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\README.zh-Hans.md" Pack="true" PackagePath="\" />
		<None Include="..\docs\**\*" Link="docs/%(Filename)%(Extension)" Pack="true" PackagePath="docs/%(RecursiveDir)" />
		<EmbeddedResource Include="Resources/PortableRuntimeIdentifierGraph.json" LogicalName="Deployer.RuntimeGraph.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Common" VersionOverride="7.9.0" />
		<PackageReference Include="NuGet.Configuration" VersionOverride="7.9.0" />
		<PackageReference Include="NuGet.Frameworks" VersionOverride="7.9.0" />
		<PackageReference Include="NuGet.Packaging" VersionOverride="7.9.0" />
		<PackageReference Include="NuGet.Protocol" VersionOverride="7.9.0" />
		<PackageReference Include="NuGet.Versioning" VersionOverride="7.9.0" />
	</ItemGroup>

	<Choose>
		<When Condition="$(Configuration)=='Debug'">
			<ItemGroup>
				<Reference Include="Zongsoft.Core">
					<HintPath>..\..\..\framework\Zongsoft.Core\src\bin\$(Configuration)\$(TargetFramework)\Zongsoft.Core.dll</HintPath>
				</Reference>
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<PackageReference Include="Zongsoft.Core" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
