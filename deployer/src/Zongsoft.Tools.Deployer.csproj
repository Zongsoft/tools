<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<LangVersion>latest</LangVersion>
		<TargetFrameworks>net8.0;net9.0;net10.0;</TargetFrameworks>
		<Version>7.12.0</Version>
		<Authors>Popeye Zhong(zongsoft@qq.com)</Authors>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dotnet-deploy</ToolCommandName>
		<PackageDescription>The Zongsoft Deployment .NET Tool.</PackageDescription>
		<Company>Zongsoft Studio</Company>
		<Product>Zongsoft Deployment Tool</Product>
		<Description>Zongsoft Application Deployment Tool.</Description>
		<Copyright>Copyright(C) Zongsoft Studio 2020-2026. All rights reserved.</Copyright>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageProjectUrl>https://github.com/Zongsoft/tools/tree/main/deployer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Zongsoft/tools/tree/main/deployer</RepositoryUrl>
		<PackageIconUrl>https://github.com/Zongsoft/guidelines/raw/main/zongsoft-logo(48x48).png</PackageIconUrl>
		<PackageIcon>zongsoft-logo.png</PackageIcon>
		<ApplicationIcon>..\..\zongsoft-logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources/dotnet-runtime-LICENSE.txt" />
		<None Include="Resources/dotnet-runtime-LICENSE.txt" Pack="true" PackagePath="licenses/" />
		<None Include="..\..\zongsoft-logo.png" Pack="true" PackagePath="\" Visible="true" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\README.zh-Hans.md" Pack="true" PackagePath="\" />
		<None Include="..\docs\**\*" Link="docs/%(Filename)%(Extension)" Pack="true" PackagePath="docs/%(RecursiveDir)" />
		<EmbeddedResource Include="Resources/PortableRuntimeIdentifierGraph.json" LogicalName="Deployer.RuntimeGraph.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Common" Version="7.9.0" />
		<PackageReference Include="NuGet.Configuration" Version="7.9.0" />
		<PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
		<PackageReference Include="NuGet.Packaging" Version="7.9.0" />
		<PackageReference Include="NuGet.Protocol" Version="7.9.0" />
		<PackageReference Include="NuGet.Versioning" Version="7.9.0" />
	</ItemGroup>

	<Choose>
		<When Condition="$(Configuration)=='Debug'">
			<ItemGroup>
				<Reference Include="Zongsoft.Core">
					<HintPath>..\..\..\framework\Zongsoft.Core\src\bin\$(Configuration)\$(TargetFramework)\Zongsoft.Core.dll</HintPath>
				</Reference>
			</ItemGroup>
		</When>
		<Otherwise>
			<ItemGroup>
				<PackageReference Include="Zongsoft.Core" Version="7.59.0" />
			</ItemGroup>
		</Otherwise>
	</Choose>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
