<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dotnet-regular</ToolCommandName>
		<PackageId>Zongsoft.Tools.Regular</PackageId>
		<Version>2.0.0</Version>
		<PackageDescription>The Zongsoft Regular Expression .NET Tool.</PackageDescription>
		<Product>Zongsoft Regular Expression Tool</Product>
		<Description>A Windows regular expression tester for matches, groups, and captures.</Description>
		<PackageProjectUrl>https://github.com/Zongsoft/tools/tree/main/regular</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Zongsoft/tools/tree/main/regular</RepositoryUrl>
		<ApplicationIcon>..\..\zongsoft-logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\README.zh-Hans.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<Target Name="PackRegularGui" AfterTargets="PackTool">
		<Error Condition="'$(RegularPublishDir)' == ''" Text="Specify RegularPublishDir when packing the Regular tool." />
		<Error Condition="!Exists('$(RegularPublishDir)\$(TargetFramework)\Zongsoft.Tools.Regular.exe')" Text="Regular GUI executable was not found in RegularPublishDir for $(TargetFramework)." />
		<Error Condition="!Exists('$(RegularPublishDir)\$(TargetFramework)\Zongsoft.Tools.Regular.runtimeconfig.json')" Text="Regular GUI runtime configuration was not found in RegularPublishDir for $(TargetFramework)." />

		<ItemGroup>
			<_RegularGuiFile Include="$(RegularPublishDir)\$(TargetFramework)\**\*" />
			<TfmSpecificPackageFile Include="@(_RegularGuiFile)" PackagePath="tools/$(TargetFramework)/any/gui/%(_RegularGuiFile.RecursiveDir)%(_RegularGuiFile.Filename)%(_RegularGuiFile.Extension)" />
		</ItemGroup>
	</Target>
</Project>
