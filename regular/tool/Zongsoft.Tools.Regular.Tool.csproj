<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>dotnet-regular</ToolCommandName>
		<PackageId>Zongsoft.Tools.Regular</PackageId>
		<Version>1.1.0</Version>
		<PackageDescription>The Zongsoft Regular Expression .NET Tool.</PackageDescription>
		<Product>Zongsoft Regular Expression Tool</Product>
		<Description>A Windows regular expression tester for matches, groups, and captures.</Description>
		<PackageProjectUrl>https://github.com/Zongsoft/tools/tree/main/regular</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Zongsoft/tools/tree/main/regular</RepositoryUrl>
		<ApplicationIcon>..\..\zongsoft-logo.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\README.zh-Hans.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition="'$(RegularPublishDir)' != ''">
		<None Include="$(RegularPublishDir)\**\*" Pack="true" PackagePath="tools/net10.0/any/gui/" />
	</ItemGroup>

	<Target Name="ValidateRegularPublish" BeforeTargets="PackTool">
		<Error Condition="'$(RegularPublishDir)' == ''" Text="Specify RegularPublishDir when packing the Regular tool." />
		<Error Condition="!Exists('$(RegularPublishDir)\Zongsoft.Tools.Regular.exe')" Text="Regular GUI executable was not found in RegularPublishDir." />
		<Error Condition="!Exists('$(RegularPublishDir)\Zongsoft.Tools.Regular.runtimeconfig.json')" Text="Regular GUI runtime configuration was not found in RegularPublishDir." />
	</Target>
</Project>
